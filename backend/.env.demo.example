# 해커톤 시연용 환경 변수 조합. backend/.env에 아래 값을 덮어써서 사용한다.
# 그 외 변수(OPENAI_API_KEY, AGENT_MODEL 등)는 backend/.env.example을 그대로 따른다.
# 실제 secret 값이나 로컬 사용자 절대경로는 이 파일에 넣지 않는다.

VISION_MODE=CACHED
AGENT_MODE=LIVE
CALENDAR_MODE=LIVE
APP_TIMEZONE=Asia/Seoul
GOOGLE_CALENDAR_ID=primary
GOOGLE_TOKEN_PATH=token.json

# 위 조합을 쓰기 전에 필요한 것:
# 1. backend/scripts/issue_google_token.py를 한 번 실행해 backend/token.json을 발급해둔다
#    (GOOGLE_CREDENTIALS_PATH로 credentials.json 위치를 지정해야 한다 - .env.example 참고).
# 2. AGENT_MODE=LIVE는 실제 OpenAI API를 호출한다 - AGENT_MODEL_ID/AGENT_MODEL_API_KEY(또는
#    AGENT_MODEL, OPENAI_API_KEY)가 backend/.env에 채워져 있어야 한다.
#
# 네트워크나 인증이 준비되지 않은 자리에서 데모해야 한다면 CACHED 조합을 대신 쓴다:
#   VISION_MODE=CACHED
#   AGENT_MODE=FALLBACK
#   CALENDAR_MODE=CACHED
# 이 조합은 외부 API를 전혀 호출하지 않고 완전히 결정론적으로 동작한다.
