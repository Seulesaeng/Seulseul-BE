# 슬슬 백엔드 환경 변수 예시. backend/.env로 복사해서 사용한다.
# 실제 값이 채워진 .env, credentials.json, token.json은 절대 커밋하지 않는다.

# --- 실행 모드 (CLAUDE.md 참고) ---
# visionMode는 POST /api/analyses 응답에만, agentMode는 POST /api/analyses/{id}/schedule,
# POST /api/analyses/{id}/retry 응답에만 노출된다.
VISION_MODE=CACHED
AGENT_MODE=LIVE
CALENDAR_MODE=CACHED

# --- 서버 ---
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- smolagents ToolCallingAgent용 LLM ---
# 실제 사용할 모델/프로바이더에 맞게 채운다. 값을 추측해서 코드에 하드코딩하지 않는다.
AGENT_MODEL_ID=
AGENT_MODEL_API_KEY=

# --- backend/scripts/generate_vision_cache.py 전용 ---
# 런타임 서버(uvicorn)는 이 값을 쓰지 않는다(기본 VISION_MODE=CACHED, vision_cache.json만 읽음).
# 이 스크립트를 실제로 실행해 vision_cache.json을 재생성할 때만 필요하다.
OPENAI_API_KEY=
VISION_MODEL=

# --- backend/spikes/smolagents_spike.py 전용 ---
# ToolCallingAgent 스파이크가 사용할 모델. OPENAI_API_KEY는 위 값을 그대로 재사용한다.
AGENT_MODEL=

# --- Google Calendar (CALENDAR_MODE=LIVE일 때만 사용) ---
# LIVE 실패 시 backend/data/calendar_events.json 기반 CACHED 이벤트로 자동 fallback한다.
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=./token.json
GOOGLE_CALENDAR_ID=primary
